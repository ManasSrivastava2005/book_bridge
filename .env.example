# Copy this file to .env and replace every placeholder. Do not commit .env.
DATABASE_URL=postgresql+psycopg2://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/YOUR_DATABASE_NAME
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=30

# Retained cloud settings (inactive for the local Book Summarizer).
OPENAI_API_KEY=
GEMINI_API_KEY=
BOOKBRIDGE_SUMMARY_MODEL=gemini-3.1-flash-lite

# Active summarization runs locally; no API key or cloud fallback.
LOCAL_SUMMARY_MODEL_NAME=google/flan-t5-base
# Optional absolute path to a downloaded or future fine-tuned model folder:
# LOCAL_SUMMARY_MODEL_PATH=C:/Backend/bookbbbb/models/flan-t5-base
LOCAL_SUMMARY_THREADS=4

# Comma-separated browser origins allowed during development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
